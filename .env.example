# App — backend URL only, never vendor keys
# Leave unset in Expo Go: the app talks to Metro (same QR/LAN host),
# which proxies /api to the server on port 3000.
# EXPO_PUBLIC_API_URL=http://localhost:8081

# Server
SERPAPI_API_KEY=

PERFECT_CORP_API_KEY=
PERFECT_CORP_API_BASE=https://yce-api-01.makeupar.com

# Optional prove-script defaults
# PERFECT_CORP_GENDER=male
# PERFECT_CORP_STYLE=random

# Only if temporary external storage becomes necessary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Dev only — skip SerpApi / Perfect Corp and return server/fixtures JSON
# USE_FIXTURES=1
# FIXTURE_SCAN=empty
# FIXTURE_SCAN=watch

